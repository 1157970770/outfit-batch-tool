# 构建产物（体积大，放 GitHub Releases，不进仓库）
dist/
build/
build_*/
*.spec

# Python 缓存
__pycache__/
*.py[cod]
.venv/
venv/

# 本地产物与临时目录
out/
_tmp*/
*.part
*.log

# 本机工具链（RunningHub skill 等），与产品无关
.dsh/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 含密钥的本地配置（真身放在 %APPDATA%\RHOutfitTool\config.json）
config.json
cos.json

# 程序运行配置（含 RH_API_KEY，绝不提交）
配置.ini

# 测试临时目录
.tmp/

# 临时探针脚本（下划线开头）
_*.py
# 例外：测试的共享临时目录 helper 要进仓库
!tests/_tmpdir.py

# 真实密码表（含分配出去的密码，绝不提交）
server/passwords.json

# 其他 agent 的工作记忆
.workbuddy/
