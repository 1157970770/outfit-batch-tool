# 构建产物（体积大，放 GitHub Releases，不进仓库）
dist/
dist-official/
dist-official-onefile/
release/
build/
build_*/
*.spec

# Python 缓存
__pycache__/
*.py[cod]
.venv/
venv/

# 本地产物与临时目录
out/
_tmp*/
*.part
*.log

# 本机工具链（RunningHub skill 等），与产品无关
.dsh/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 含密钥的本地配置（真身放在 %APPDATA%\RHOutfitTool\config.json）
config.json
cos.json
# 生图 tab 的老张 API Key（模板是 server/imagegen.example.json）
server/imagegen.json

# 程序运行配置（含 RH_API_KEY，绝不提交）
配置.ini

# 用户本地的定妆图（正式素材，不进仓库）
assets/定妆图.jpg
assets/定妆图.png

# 测试临时目录
.tmp/

# 临时探针脚本（下划线开头）
_*.py
# 例外：测试的共享临时目录 helper 要进仓库
!tests/_tmpdir.py
# 例外：包的 __init__.py 必须入库（上面的 _*.py 会误伤，见 AGENTS.md §7）
!**/__init__.py

# 真实密码表（含分配出去的密码，绝不提交）
server/passwords.json

# 其他 agent 的工作记忆
.workbuddy/

# 旧 RH 版隔离工作树（不要提交；旧版原样保留在这里）
.worktrees/

# 局域网网页服务的本机数据与秘密配置
dist-web/
web-data/
# 分区后的 dev 数据目录与生产快照归档（web-data-dev/、web-data-生产快照-*）
web-data*/
server/web.json
# 飞书自动报表凭证（app secret + 表定位，只留本机，两区各放一份）
server/feishu.json

# 运行区专用运维脚本（切换/回滚，含本机绝对路径，只存运行区本机）
运维/

# 配置文件备份（web.json / config.json 的历史副本，可能含明文 Key，只留本机）
*.bak-*

# 前端改动的临时备份（回滚用，不进仓库）
.backup-ui/

# 打标工具的运行时状态
_state/

# 例外：包初始化文件不是临时脚本（上面的 _*.py 会误伤 __init__.py）
# 注意：新增子包时必须在这里补一行，否则 __init__.py 不进仓库，
# 克隆/发布出去的目录会变成命名空间包，`from app.xxx import ...` 直接 ImportError。
!app/web/__init__.py
!app/imggen/__init__.py

# 临时网络探测脚本（排查 npm 源用，与产品无关）
probe-registry.mjs

# 画布前端源码的依赖与构建临时目录（构建产物 app/web/static/canvas/ 要入库）
canvas/node_modules/
canvas/.tmp/

# 素材检索（2026-11-09 从 D:\定妆自动化区\04_检索 迁入本区；旧路径保留目录联接指回这里）
# data/ 是 14MB 索引与生成物，logs/ 与 当前网址.txt 是运行时产物，单文件版 HTML 3.9MB 也不入库
素材检索/data/
素材检索/lan/logs/
素材检索/lan/当前网址.txt
素材检索/素材检索.html
