# ── 数据与配置（默认沿用设计区现有文件，零拷贝即可跑）─────────────────────────
# 存放 web.json / config.json / imagegen.json 的目录
OUTFIT_SERVER_DIR=../server
# 运行数据根目录（jobs / batches / uploads / output / template_tags.json …）
OUTFIT_DATA_ROOT=../web-data-dev
# API 监听端口（Python 设计区用 8766，这里用 3001，互不冲突）
PORT=3001
# 允许访问的 Host（逗号分隔，留空 = 127.0.0.1 / localhost / 本机网段）
OUTFIT_ALLOWED_HOSTS=

# ── 开发辅助 ────────────────────────────────────────────────────────────────
# 1 = 把 Wan 请求指向 tests/mock_dashscope.py（不花钱）
MOCK_WAN=0
MOCK_WAN_BASE_URL=http://127.0.0.1:18090

# ── 妙搭部署时由环境变量覆盖，绝不入库 ─────────────────────────────────────
# WAN_API_KEY=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# IMAGEGEN_API_KEY=
